# ==============================================================================
# Routewise Python Microservice Environment Variables (.env.example)
# Copy to .env for local testing or populate in Render Dashboard
# ==============================================================================

# Server Port (Render sets this automatically)
PORT=8000

# Allowed CORS Origins (Comma-separated list of origins)
ALLOWED_ORIGINS=https://routewise.vercel.app,http://localhost:3000,http://localhost:8080
