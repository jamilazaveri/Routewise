# ==============================================================================
# Routewise Java Backend Environment Variables (.env.example)
# Copy to .env for local testing or populate in Render Dashboard
# ==============================================================================

# Server Port (Render sets this automatically)
PORT=8080

# Cloud Database Connection URL (MySQL 8+ compatible, e.g., TiDB Cloud Serverless or Aiven)
# Ensure useSSL=true is appended for cloud providers
DB_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/routewise_db?useSSL=true&requireSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database Credentials
DB_USER=root.your_tenant_id
DB_PASSWORD=your_secure_db_password

# Internal / Public URL to the Python FastAPI Microservice
PYTHON_SERVICE_URL=https://routewise-service-python.onrender.com

# Allowed CORS Origins (Comma-separated list of deployed frontend URLs + local dev)
ALLOWED_ORIGINS=https://routewise.vercel.app,http://localhost:3000,http://127.0.0.1:3000
