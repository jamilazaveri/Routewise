# ==============================================================================
# Routewise Full-Stack Deployment Environment Variables (.env.example)
# Use this reference when setting up your cloud deployment on Render & Vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Free Cloud MySQL 8+: TiDB Cloud Serverless or Aiven MySQL)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://<your-tidb-or-aiven-host>:4000/routewise_db?useSSL=true&requireSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=<your-db-username>
DB_PASSWORD=<your-db-password>

# ------------------------------------------------------------------------------
# 2. PYTHON FASTAPI MICROSERVICE (Render Free Web Service)
# ------------------------------------------------------------------------------
PYTHON_SERVICE_URL=https://routewise-service-python.onrender.com

# ------------------------------------------------------------------------------
# 3. JAVA SPRING BOOT BACKEND (Render Free Web Service)
# ------------------------------------------------------------------------------
JAVA_BACKEND_URL=https://routewise-backend-java.onrender.com
ALLOWED_ORIGINS=https://routewise.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. FRONTEND (Vercel)
# ------------------------------------------------------------------------------
# In frontend/js/config.js, API_BASE_URL points to JAVA_BACKEND_URL in production
API_BASE_URL=https://routewise-backend-java.onrender.com
